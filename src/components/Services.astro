---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cards = [1, 2, 3, 4].map((n) => ({
  title: t(`services.card${n}.title`),
  desc: t(`services.card${n}.desc`),
}));
---
<section class="max-w-4xl mx-auto px-6 py-12 border-t border-border">
  <h2 class="text-2xl font-semibold tracking-tight text-fg mb-2">{t('services.heading')}</h2>
  <p class="text-muted leading-relaxed max-w-2xl mb-8">{t('services.subtitle')}</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {cards.map((c) => (
      <div class="border border-border rounded-lg p-4 bg-surface/50">
        <h3 class="font-semibold text-fg mb-1">{c.title}</h3>
        <p class="text-sm text-muted leading-relaxed">{c.desc}</p>
      </div>
    ))}
  </div>
  <div class="mt-8">
    <a
      href={localizePath('/contact', lang)}
      class="inline-block text-sm font-mono px-4 py-2 rounded-md bg-accent text-bg hover:bg-accent2 transition"
    >
      {t('services.cta')} →
    </a>
  </div>
</section>
